# Optional. The app uses the public /signalrcore live-timing endpoint, which
# needs no account or token, so this is normally left unset.
#
# If set, deploy.sh injects it into the deployed external.manifest.json as an
# app environment variable (it is never written to the committed manifest).
F1_TOKEN=

# Optional. Comma-separated resolvers used instead of the device's
# /etc/resolv.conf, which is often empty on the Paper Pro. "system" uses the
# OS resolver as-is. Defaults to 8.8.8.8, then 1.1.1.1, then system.
# F1_DNS=9.9.9.9,149.112.112.112
